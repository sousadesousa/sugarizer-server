<%- include('includes/header') %>
<%- include('includes/navbar') %>
<div class="main-content">
  <div class="container-fluid">
    <div class="row justify-content-center" style="margin-top:100px;">
      <div class="col-12 col-lg-6 col-xl-4">
        <h3 class="text-center"><%= server.name %></h3>
        <h5 class="text-center" data-l10n-id="2FA-message"></h5>
        <div class="card card-nav-tabs">
            <div class="card-body">
              <%- include('includes/flash-errors') %>
              <form method="post" action="/dashboard/verify2FA">
                <div class="mb-3">
                    <label class="form-label" for="token" data-l10n-id="2FA">Username</label>
                    <input class="form-control" type="text" name="tokenentry" id="token"
                    inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code"/>
                </div>
                <button class="btn btn-round float-end" type="submit" onclick="updateLanguage()" data-l10n-id="verify">Login</button>
                <div class="clearfix"></div>
              </form>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function updateLanguage() {
	document.getElementById('formlang').value = document.getElementById('languageSelection').value;
}
</script>

<%- include('includes/footer') %>
