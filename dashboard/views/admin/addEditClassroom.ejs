<%- include('../includes/header') %>
  <div class="wrapper">
  	<%- include('../includes/sidebar') %>
    	<div class="main-area">
    	<%- include('../includes/navbar') %>
    		<div class="content">
    			<div class="container-fluid">
            <div class="col-lg-8">
              <div class="card">
                <div class="card-body">
                    <%- include('../includes/flash-errors') %>
                    <form id="classroom-add-edit-form" method="post" <% if(typeof classroom == 'object'){ %> action="<%= classroom._id %>" <% } %>>
                        <div class="row" id="editClassroom-name">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" data-l10n-id="name"></label>
                                    <input class="form-control" name="name" value="<% if(typeof classroom == 'object'){ %><%= classroom.name %><% } %>" type="text">
                                </div>
                            </div>
                        </div>
                        <div class="row" id="editClassroom-students">
                            <div class="col-12">
                                <div class="mb-3" style="margin-top: -15px;">
                                    <label class="form-label" data-l10n-id="students"></label>
                                    <select id="select-students-select2" multiple="multiple" name="students" class="form-select">
                                        <% if(typeof classroom == 'object') { %>
                                            <% for(var i=0; i < classroom.students.length; i++) { %>
                                                <option selected value='<%= classroom.students[i]._id %>'><%= classroom.students[i].name %></option>
                                            <% } %>
                                        <% } %>
                                    </select>
                                    <script>
                                        $(document).ready(function() {
                                            document.webL10n.ready(function() {
                                                var refreshIntervalId = setInterval(function() {
                                                    if (document.webL10n.getReadyState() == "complete") {
                                                        clearInterval(refreshIntervalId);

                                                        if ($("#select-students-select2").length > 0) {
                                                            $("#select-students-select2").select2({
                                                                ajax: {
                                                                    url: "/dashboard/users/search",
                                                                    dataType: 'json',
                                                                    delay: 250,
                                                                    data: function (params) {
                                                                        return {
                                                                            q: params.term
                                                                        };
                                                                    },
                                                                    processResults: function (data) {
                                                                        if (data && data.data && data.data.users && data.data.users.length > 0) {
                                                                            for (var i=0; i<data.data.users.length; i++) {
                                                                                data.data.users[i].id = data.data.users[i]._id;
                                                                                data.data.users[i].text = data.data.users[i].name;
                                                                            }
                                                                            return {
                                                                                results: data.data.users
                                                                            };
                                                                        } else {
                                                                            return {
                                                                                results: []
                                                                            };
                                                                        }
                                                                    },
                                                                    cache: true
                                                                },
                                                                multiple: true,
                                                                templateResult: formatUserField,
                                                                placeholder: document.webL10n.get("searchUser")
                                                            });
                                                        }
                                                    }
                                                }, 100);
                                            });
                                        });
                                    </script>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="editClassroom-activities">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" data-l10n-id="classroomActivities"></label>
                                    <p class="text-muted" data-l10n-id="classroomActivitiesHint"></p>
                                    <div class="classroom-activities" style="max-height: 260px; overflow-y: auto; border: 1px solid #ddd; border-radius: 4px; padding: 8px;">
                                        <% var assigned = (typeof classroom == 'object' && Array.isArray(classroom.activities)) ? classroom.activities : []; %>
                                        <% var toolbarOverrides = (typeof classroom == 'object' && classroom.toolbarOverrides) ? classroom.toolbarOverrides : {}; %>
                                        <% for (var i = 0; i < activities.length; i++) { %>
                                            <div class="form-check form-check-inline" style="width: 360px; margin: 4px 8px;">
                                            <input class="form-check-input" id="activity-<%= activities[i].id %>" type="checkbox" name="activities" value="<%= activities[i].id %>" <% if (assigned.indexOf(activities[i].id) != -1) { %>checked<% } %>>
                                            <label class="form-check-label" for="activity-<%= activities[i].id %>">
                                                <img src="/<%= activities[i].directory %>/<%= activities[i].icon %>" alt="" style="width: 24px; height: 24px; margin: 0 6px;">
                                                <%= activities[i].name %>
                                            </label>
                                            <select class="form-select form-select-sm" name="toolbarOverrides" style="width:auto; display:inline-block; margin-left: 8px;" data-activity-id="<%= activities[i].id %>">
                                                <option value="" <% if (typeof toolbarOverrides[activities[i].id] === 'undefined') { %>selected<% } %> data-l10n-id="toolbarClassDefault"></option>
                                                <option value="<%= activities[i].id %>=simple" <% if (toolbarOverrides[activities[i].id] === 'simple') { %>selected<% } %> data-l10n-id="toolbarSimple"></option>
                                                <option value="<%= activities[i].id %>=full" <% if (toolbarOverrides[activities[i].id] === 'full') { %>selected<% } %> data-l10n-id="toolbarFull"></option>
                                            </select>
                                        </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="editClassroom-toolbar">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" data-l10n-id="classroomToolbar"></label>
                                    <p class="text-muted" data-l10n-id="classroomToolbarHint"></p>
                                    <select class="form-select" name="toolbarMode" id="toolbarMode">
                                        <option value="full" <% if (!(typeof classroom == 'object' && classroom.toolbarMode === 'simple')) { %>selected<% } %> data-l10n-id="toolbarFull"></option>
                                        <option value="simple" <% if (typeof classroom == 'object' && classroom.toolbarMode === 'simple') { %>selected<% } %> data-l10n-id="toolbarSimple"></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row color_input" id="editClassroom-colors">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" data-l10n-id="color"></label>
                                    <select class="form-select" name="color" id="color-select2">
                                        <% if(typeof classroom == "undefined") var random=Math.floor(Math.random()*xocolors.length); %>
                                        <% for(var i=0; i< xocolors.length; i++){ %>
                                          <% if(typeof classroom == 'object' && (typeof classroom.color == 'object' && xocolors[i].stroke == classroom.color.stroke && xocolors[i].fill == classroom.color.fill) || (random == i)) { %>
                                            <option selected="selected" data-stroke="<%= xocolors[i].stroke %>" data-icon="classroom-icon" data-fill="<%= xocolors[i].fill %>" value="<%= JSON.stringify(xocolors[i]) %>"></option>
                                          <% }else{ %>
                                            <option data-stroke="<%= xocolors[i].stroke %>" data-icon="classroom-icon" data-fill="<%= xocolors[i].fill %>" value="<%= JSON.stringify(xocolors[i]) %>"></option>
                                          <% } %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <% if(typeof classroom == 'object' && classroom.created_time) { %>
                        <div class="row" id="editClassroom-created">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" data-l10n-id="createdTime"></label>
                                    <input class="form-control" readonly value="<%= moment(classroom.created_time).calendar() %>" data-local-time="<%= classroom.created_time %>" type="text">
                                </div>
                            </div>
                        </div>
                        <% } %>
                        <% if(typeof classroom == 'object' && classroom.timestamp) { %>
                        <div class="row" id="editClassroom-lastupdated">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" data-l10n-id="lastUpdated"></label>
                                    <input class="form-control" readonly value="<%= moment(classroom.timestamp).calendar() %>" data-local-time="<%= classroom.timestamp %>" type="text">
                                </div>
                            </div>
                        </div>
                        <% } %>
                        <button class="btn float-end btn-round" type="submit" data-l10n-id="save"></button>
                        <a class="btn float-end btn-round" href="/dashboard/classrooms" data-l10n-id="cancel"></a>
                        <div class="clearfix"></div>
                    </form>
                    <script>
                        // Toggle toolbar override visibility based on checkbox state
                        function toggleToolbarOverrideVisibility() {
                            document.querySelectorAll('input[name="activities"]').forEach(function(checkbox) {
                                var activityId = checkbox.value;
                                var overrideSelect = document.querySelector('select[name="toolbarOverrides"][data-activity-id="' + activityId + '"]');
                                if (overrideSelect) {
                                    overrideSelect.style.display = checkbox.checked ? 'inline-block' : 'none';
                                }
                            });
                        }

                        document.addEventListener('DOMContentLoaded', function() {
                            toggleToolbarOverrideVisibility();
                            document.querySelectorAll('input[name="activities"]').forEach(function(checkbox) {
                                checkbox.addEventListener('change', toggleToolbarOverrideVisibility);
                            });
                        });
                    </script>
                </div>
              </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<%- include('../includes/footer') %>

<script>
    var currTour = sugarizerTour("editClassroom", <% if (account.user && account.user.role=="admin") { %> "admin" <% } else { %> "teacher" <% } %>, "<%= mode %>");
    if (!currTour.isFinished()) currTour.start();
</script>
