<% if(messages.errors){ %>
  <script>
    $( document ).ready(function() {
      <% for (var key in messages.errors) { %>
      notify(<%- jsonForScript(messages.errors[key].msg) %>, 'danger');
      <% } %>
    });
  </script>
<% } %>

<% if(messages.success){ %>
  <script>
    $( document ).ready(function() {
      <% for (var key in messages.success) { %>
      notify(<%- jsonForScript(messages.success[key].msg) %>, 'success');
      <% } %>
    });
  </script>
<% } %>
