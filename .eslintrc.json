{
    "env": {
        "browser": true,
        "node": true,
        "mocha": true,
        "jquery": true,
        "mongo": true,
        "amd": true
    },
    "extends": "eslint:recommended",
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 5,
        "sourceType": "script"
    },
    "rules": {
        "indent": [
            "error",
            "tab"
        ],
        "linebreak-style": [
            "error",
            "unix"
        ],
        "semi": [
            "error",
            "always"
        ],
        "eol-last": [
            "error",
            "always"
        ],
        "no-mixed-spaces-and-tabs": "error",
        "no-console": 0,
        "no-redeclare": "off",
        "no-unused-vars": ["error", {"caughtErrors": "none"}]
    },
    "overrides": [
        {
            "files": ["seed_users.js"],
            "parserOptions": {
                "ecmaVersion": 6
            },
            "env": {
                "node": true,
                "es6": true
            },
            "rules": {
                "indent": "off"
            }
        },
        {
            "files": ["docs/www/main.js"],
            "rules": {
                "indent": "off"
            },
            "globals": {
                "List": "readonly"
            }
        },
        {
            "files": ["dashboard/public/js/main.js"],
            "rules": {
                "no-unused-vars": "off"
            },
            "globals": {
                "url": "writable",
                "headers": "writable",
                "icon": "readonly",
                "bootstrap": "readonly",
                "Chart": "readonly",
                "QRCode": "readonly",
                "saveAs": "readonly",
                "Uint8Array": "readonly"
            }
        },
        {
            "files": ["dashboard/public/js/tutorial.js"],
            "globals": {
                "introJs": "readonly"
            },
            "rules": {
                "no-unused-vars": "off"
            }
        },
        {
            "files": ["dashboard/controller/users/importCSV.js"],
            "parserOptions": {
                "ecmaVersion": 6
            },
            "env": {
                "es6": true
            }
        },
        {
            "files": ["api/**/*.js"],
            "parserOptions": {
                "ecmaVersion": 6
            },
            "env": {
                "node": true,
                "es6": true
            }
        },
        {
            "files": ["sugarizer.js", "eslint.config.js", "config/**/*.js", "api/**/*.js", "dashboard/controller/**/*.js", "dashboard/helper/**/*.js", "scripts/**/*.js"],
            "parserOptions": {
                "ecmaVersion": 2018
            },
            "env": {
                "node": true,
                "es6": true
            }
        },
        {
            "files": ["playwright.config.js", "test/e2e/**/*.js"],
            "parserOptions": {
                "ecmaVersion": 2022
            },
            "env": {
                "node": true,
                "es2021": true
            }
        }
    ]
}
