# Self-contained Sugarizer Server image: client and server cloned at build time
# Needs a MongoDB reachable as "mongodb" (see env/docker.ini), for example:
#   docker build -f docker/Dockerfile-standalone -t sugarizer .
#   docker run --link mongodb -p 8080:8080 -p 8039:8039 sugarizer

FROM node:22-bookworm-slim AS build
ARG CLIENT_REPOSITORY=https://github.com/llaske/sugarizer
ARG CLIENT_REF=master
ARG SERVER_REPOSITORY=https://github.com/llaske/sugarizer-server
ARG SERVER_REF=master
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone --depth 1 --branch "$CLIENT_REF" "$CLIENT_REPOSITORY" sugarizer \
	&& git clone --depth 1 --branch "$SERVER_REF" "$SERVER_REPOSITORY" sugarizer-server
# optimized (minified) client and dashboard
WORKDIR /opt/sugarizer
RUN npm ci --no-audit --no-fund && npx grunt && rm -rf node_modules .git
WORKDIR /opt/sugarizer-server
# --force: image optimization needs native tools that may not install, the rest is still minified
RUN npm ci --no-audit --no-fund && npx grunt --force && cp -r build/* . && rm -rf build node_modules .git \
	&& npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim
ENV NODE_ENV=docker
# curl is used by add-admin.sh
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/sugarizer /sugarizer-client
COPY --from=build /opt/sugarizer-server /sugarizer-server
WORKDIR /sugarizer-server
RUN mkdir -p tmp/csv && chown -R node:node tmp env
USER node
EXPOSE 8080 8039
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
	CMD node -e "fetch('http://127.0.0.1:8080/api').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
CMD ["node", "sugarizer.js"]
